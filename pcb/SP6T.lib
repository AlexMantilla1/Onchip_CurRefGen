* =====================================================================
* SP6T.lib  --  Selector de 6 posiciones (1 polo, 6 vias) para LTspice
* Sirve para el selector por jumper (header 2x6 + 1 jumper) o para un
* rotativo SP6T. Cambia los parametros segun la hoja de datos de la parte.
*
* Pines:   COM  T1  T2  T3  T4  T5  T6
*
* MODO ESTATICO (tsw = 0): la posicion 'pos' (1..6, 0 = ninguna) queda
*   fija toda la simulacion. Sirve con .step para barrer posiciones.
*
* MODO POR TIEMPO (tsw > 0): el selector cambia dentro del transitorio:
*   t < tstart                  -> posicion 1
*   tstart + (k-2)*tsw ... +tsw -> posicion k  (k = 2..6)
*   despues de la 6 vuelve a la 1 y repite (periodo 6*tsw)
*   Cada cambio es "abre y luego cierra" (como mover un jumper):
*   tgap = tiempo sin conexion entre posiciones
*   ttr  = duracion de la transicion (suave, evita problemas de
*          convergencia). Ej. tstart=2m, tsw=1m: 1 hasta 2 ms, 2 de 2 a
*          3 ms, ..., 6 de 6 a 7 ms. Con .tran 0 7m se ven las 6.
*
* Params:  Ron  = resistencia de contacto (posicion conectada)
*          Roff = resistencia de aislamiento (valor MINIMO de datasheet)
*          Cp   = capacitancia parasita COM-Tn (estimada)
* Valores por defecto: tipicos de header 2.54 mm + jumper. VERIFICAR:
*   header + jumper:  Ron ~ 20m,  Roff >= 1000Meg
*   rotativo SP6T:    Ron ~ 100m, Roff >= 100Meg  (ej. C&K serie RM)
* =====================================================================
.subckt SP6T COM T1 T2 T3 T4 T5 T6 params: pos=1 tsw=0 tstart=2m tgap=10u ttr=1u Ron=20m Roff=1000Meg Cp=0.5p
.param tswx = {max(tsw,1n)}
R1 COM T1 R=if(tsw==0, if(pos==1,Ron,Roff), exp(ln(Roff)+(limit(((max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx)))-0*tswx-tgap)/ttr,0,1)*limit((0*tswx+tswx-(max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx))))/ttr,0,1))*(ln(Ron)-ln(Roff))))
R2 COM T2 R=if(tsw==0, if(pos==2,Ron,Roff), exp(ln(Roff)+(limit(((max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx)))-1*tswx-tgap)/ttr,0,1)*limit((1*tswx+tswx-(max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx))))/ttr,0,1))*(ln(Ron)-ln(Roff))))
R3 COM T3 R=if(tsw==0, if(pos==3,Ron,Roff), exp(ln(Roff)+(limit(((max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx)))-2*tswx-tgap)/ttr,0,1)*limit((2*tswx+tswx-(max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx))))/ttr,0,1))*(ln(Ron)-ln(Roff))))
R4 COM T4 R=if(tsw==0, if(pos==4,Ron,Roff), exp(ln(Roff)+(limit(((max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx)))-3*tswx-tgap)/ttr,0,1)*limit((3*tswx+tswx-(max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx))))/ttr,0,1))*(ln(Ron)-ln(Roff))))
R5 COM T5 R=if(tsw==0, if(pos==5,Ron,Roff), exp(ln(Roff)+(limit(((max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx)))-4*tswx-tgap)/ttr,0,1)*limit((4*tswx+tswx-(max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx))))/ttr,0,1))*(ln(Ron)-ln(Roff))))
R6 COM T6 R=if(tsw==0, if(pos==6,Ron,Roff), exp(ln(Roff)+(limit(((max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx)))-5*tswx-tgap)/ttr,0,1)*limit((5*tswx+tswx-(max(time-tstart+tswx,tgap+ttr)-6*tswx*floor(max(time-tstart+tswx,tgap+ttr)/(6*tswx))))/ttr,0,1))*(ln(Ron)-ln(Roff))))
C1 COM T1 {Cp}
C2 COM T2 {Cp}
C3 COM T3 {Cp}
C4 COM T4 {Cp}
C5 COM T5 {Cp}
C6 COM T6 {Cp}
.ends SP6T
